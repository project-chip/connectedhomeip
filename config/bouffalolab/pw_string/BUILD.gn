import("//build_overrides/pigweed.gni")
import("$dir_pw_build/target_types.gni")

# Newlib + GCC libstdc++ hides C99 math functions (such as std::roundf used by
# pw_string/type_to_string.cc) behind these feature macros.
config("newlib_c99_math_config") {
  defines = [
    "_GLIBCXX_USE_C99_MATH_TR1",
    "_LDBL_EQ_DBL",
  ]
}

pw_source_set("pw_string_config") {
  public_configs = [ ":newlib_c99_math_config" ]
}
