# GN build for Google FuzzTest, whose sources are in repo/. fuzztest/ and
# common/ hold BUILD.gn files generated from FuzzTest's Bazel build with
# Pigweed's bazel_to_gn.py; Pigweed stopped shipping them in pigweed 0b14c78f6.
# The fuzztest, fuzztest_main and gtest targets below replace
# $dir_pw_fuzzer:fuzztest, :fuzztest_main and :gtest as they were at pigweed
# c14c119c5.

import("//build_overrides/pigweed.gni")

import("//third_party/fuzztest/fuzztest.gni")
import("$dir_pw_build/target_types.gni")

config("fuzztest_public_config") {
  cflags = [
    "-Wno-sign-compare",
    "-Wno-sign-conversion",
    "-Wno-shorten-64-to-32",
    "-Wno-unused-parameter",
    "-Wno-missing-field-initializers",
    "-Wno-shadow-all",
  ]
  cflags_cc = [ "-Wno-extra-semi" ]
  defines = [ "CENTIPEDE_DISABLE_RIEGELI" ]
  if (chip_fuzztest_dir != "") {
    include_dirs = [ "$chip_fuzztest_dir" ]
  }
}

group("fuzztest") {
  if (chip_fuzztest_dir != "") {
    public_deps = [ ":fuzztest.enabled" ]
  } else {
    public_deps = [ "$dir_pw_fuzzer:fuzztest.disabled" ]
  }
}

if (chip_fuzztest_dir != "") {
  config("pw_fuzzer_include_path") {
    include_dirs = [
      "$dir_pw_fuzzer/public",
      "$dir_pw_fuzzer/private",
    ]
    visibility = [ ":*" ]
  }

  # pw_fuzzer's FuzzTest wrapper (pw_fuzzer/fuzztest.h) on top of FuzzTest.
  pw_source_set("fuzztest.enabled") {
    public = [
      "$dir_pw_fuzzer/private/pw_fuzzer/internal/fuzztest.h",
      "$dir_pw_fuzzer/public/pw_fuzzer/fuzztest.h",
    ]
    public_configs = [ ":pw_fuzzer_include_path" ]
    public_deps = [
      "//third_party/fuzztest/fuzztest:fuzztest_core",
      dir_pw_containers,
      dir_pw_result,
      dir_pw_status,
      dir_pw_string,
    ]
  }

  # pw_unit_test_MAIN for the FuzzTest toolchain.
  group("fuzztest_main") {
    deps = [
      "$dir_pw_fuzzer:asan_default_options",
      "//third_party/fuzztest/fuzztest:fuzztest_gtest_main",
    ]
  }

  # pw_unit_test_BACKEND for the FuzzTest toolchain.
  group("gtest") {
    public_deps = [ "$dir_pw_unit_test:googletest" ]
  }
}
