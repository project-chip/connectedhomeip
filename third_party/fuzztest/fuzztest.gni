# Derived from Pigweed's third_party/fuzztest/fuzztest.gni; builds on plain GN
# source_set instead of pw_source_set.

declare_args() {
  # Path to the FuzzTest source tree. Set only in the FuzzTest toolchain
  # (//build/toolchain/pw_fuzzer:chip_pw_fuzztest).
  chip_fuzztest_dir = ""
}

template("fuzztest_source_set") {
  source_set(target_name) {
    forward_variables_from(invoker, "*")
    public_configs = [ "//third_party/fuzztest:fuzztest_public_config" ]
    configs += [ "//third_party/fuzztest:fuzztest_runtime" ]
  }
}
