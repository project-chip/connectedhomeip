import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")
import("${chip_root}/src/platform/device.gni")
import("${chip_root}/third_party/st/stm32_sdk.gni")

declare_args() {
  ## PATHS FOR STM32WB BOARD ##
  stm32_board_app = "${chip_root}/third_party/st/x-cube-matter/Projects/STM32WBA65I-DK1/Common/Application/App"
  stm32_project_dir_common_wba = "${chip_root}/third_party/st/x-cube-matter/Projects/STM32WBA65I-DK1/Common/"
  stm32_wb_bsp = "${chip_root}/third_party/st/x-cube-matter/Drivers/BSP"

  ## PATHS FOR ST UTILITIES ##
  stm32_util = "${chip_root}/third_party/st/x-cube-matter/Utilities"

}

# Common sources (used by both standard and OEMiROT builds)
SOURCES = [
  # BOARD APPLICATION SRC

  "${stm32_board_app}/Src/app_nvm.c",
  "${stm32_board_app}/Src/app_freertos.c",
  "${stm32_board_app}/Src/stm32_factorydata.c",

  "${stm32_project_dir_common_wba}/Application/STM32_WPAN/App/app_ble.c",
  "${stm32_project_dir_common_wba}/Application/STM32_WPAN/App/app_matter.c",
  "${stm32_project_dir_common_wba}/Application/STM32_WPAN/App/app_thread.c",
  "${stm32_project_dir_common_wba}/Application/STM32_WPAN/App/custom_stm.c",
  "${stm32_project_dir_common_wba}/Application/STM32_WPAN/Target/bleplat.c",
  "${stm32_project_dir_common_wba}/Application/STM32_WPAN/Target/bpka.c",
  "${stm32_project_dir_common_wba}/Application/STM32_WPAN/Target/host_stack_if.c",
  "${stm32_project_dir_common_wba}/Application/STM32_WPAN/Target/linklayer_plat.c",
  "${stm32_project_dir_common_wba}/Application/STM32_WPAN/Target/ll_sys_if.c",
  "${stm32_project_dir_common_wba}/Application/STM32_WPAN/Target/power_table.c",

  "${chip_root}/examples/platform/stm32/config_files/STM32WBA6/matter_config.h",
  "${chip_root}/examples/platform/stm32/config_files/STM32WBA6/FreeRTOSConfig.h",

  "${stm32_wb_bsp}/STM32WBA65I-DK1/stm32wba65i_discovery_bus.c",
  "${stm32_wb_bsp}/STM32WBA65I-DK1/stm32wba65i_discovery_lcd.c",
  "${stm32_wb_bsp}/STM32WBA65I-DK1/stm32wba65i_discovery.c",
  "${stm32_wb_bsp}/Components/ssd1315/ssd1315.c",
  "${stm32_wb_bsp}/Components/ssd1315/ssd1315_reg.c",

  # BOARD UTILITIES
  "${stm32_util}/trace/adv_trace/stm32_adv_trace.c",
  "${stm32_util}/lpm/tiny_lpm/stm32_lpm.c",
  "${stm32_util}/misc/stm32_mem.c",
  "${stm32_util}/misc/stm32_systime.c",
  "${stm32_util}/misc/stm32_tiny_sscanf.c",
  "${stm32_util}/misc/stm32_tiny_vsnprintf.c",
  "${stm32_util}/tim_serv/stm32_timer.c",
  "${stm32_util}/LCD/stm32_lcd.c",
]

INCLUDE_DIRS = [
  "${stm32_util}",
  "${stm32_util}/trace/adv_trace",
  "${stm32_util}/lpm/tiny_lpm",
  "${stm32_util}/misc",
  "${stm32_util}/tim_serv",
  "${stm32_util}/sequencer",
  "${stm32_util}/LCD",
  "${stm32_wb_bsp}/STM32WBA65I-DK1",
  "${stm32_wb_bsp}/Components/ssd1315",
  "${stm32_wb_bsp}/Components/Common",
  "${stm32_project_dir_common_wba}/Application/STM32_WPAN/Target",
  "${stm32_project_dir_common_wba}/Application/STM32_WPAN/App",
  "${stm32_project_dir_common_wba}/Application/App/Inc",
]

if(stm32_app == "lit-icd-app") {
  INCLUDE_DIRS += [ "${chip_root}/third_party/st/x-cube-matter/Projects/STM32WBA65I-DK1/Applications/Matter/Generic-Switch-App/Core/Inc"]
}else if (stm32_app == "lighting-app") {
  if (chip_enable_ota_requestor) {
      SOURCES += [
      "${stm32_project_dir_common_wba}/Application/OTA/low_level_spi_device.c",
      "${stm32_project_dir_common_wba}/Application/OTA/low_level_spi_flash.c",
      "${stm32_project_dir_common_wba}/Application/OTA/stm_ota_spi_flash.c",
      "${stm32_wb_bsp}/STM32WBA65I-DK1/stm32wba65i_discovery_eeprom.c",
      "${stm32_wb_bsp}/Components/m95p32/m95p32.c",

                    ]
      INCLUDE_DIRS += [ 
                        "${stm32_wb_bsp}/Components/m95p32",
                        "${stm32_project_dir_common_wba}/Application/OTA",
                        "${chip_root}/third_party/st/x-cube-matter/Projects/STM32WBA65I-DK1/Applications/ROT_Lighting_OEMiRoT/OEMiROT_Appli_TrustZone/NonSecure/Core/Inc",
                        "${chip_root}/third_party/st/x-cube-matter/Middlewares/Third_Party/mcuboot/platform/ext/driver",
                        "${chip_root}/examples/platform/stm32/STM32WBA65I-DK1/oemirot/Secure_nsclib"
                       ]
  } else {
      INCLUDE_DIRS += [ "${chip_root}/third_party/st/x-cube-matter/Projects/STM32WBA65I-DK1/Applications/Matter/Lighting-App/Core/Inc"]
  }
}

DEFINES = []

LIBS = []

FLAGS = []
