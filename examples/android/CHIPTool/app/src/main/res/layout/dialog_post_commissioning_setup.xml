<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="24dp"
      android:paddingEnd="24dp"
      android:paddingTop="16dp"
      android:paddingBottom="16dp">

    <!-- Header Description / Node info -->
    <TextView
        android:id="@+id/dialogSubtitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Configure device name and room placement."
        android:textSize="13sp"
        android:textColor="@color/colorOnSurfaceVariant"
        android:layout_marginBottom="16dp" />

    <!-- 1. Device Name Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/deviceNameLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Device Name"
        android:layout_marginBottom="12dp"
        app:startIconDrawable="@android:drawable/ic_menu_edit">

      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/deviceNameEditText"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:inputType="textCapWords"
          android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 2. Room Selection Dropdown -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/roomSelectLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Room Assignment"
        android:layout_marginBottom="12dp"
        app:startIconDrawable="@android:drawable/ic_menu_myplaces">

      <AutoCompleteTextView
          android:id="@+id/roomAutoComplete"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:inputType="none"
          android:text="Unassigned" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 2b. Custom Room Field (Visible only if "+ New Room" is selected) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/customRoomLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="New Room Name"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:startIconDrawable="@android:drawable/ic_input_add">

      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/customRoomEditText"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:inputType="textCapWords"
          android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 3. Sync NodeLabel to Basic Information Cluster Checkbox -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/syncNodeLabelCheckbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Write name to NodeLabel (Basic Information Cluster)"
        android:textSize="12sp"
        android:checked="true"
        android:layout_marginTop="4dp" />

  </LinearLayout>
</ScrollView>
