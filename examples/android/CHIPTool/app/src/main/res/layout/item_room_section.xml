<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="16dp">

  <!-- Room Header Section -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingStart="20dp"
      android:paddingEnd="16dp"
      android:paddingTop="12dp"
      android:paddingBottom="4dp">

    <TextView
        android:id="@+id/roomNameText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Living Room"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/colorOnSurface" />

    <!-- Room Summary Badge -->
    <TextView
        android:id="@+id/roomCountBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/colorSurfaceVariant"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="3 devices • 3 online"
        android:textSize="11sp"
        android:textColor="@color/centerTextSecondary" />
  </LinearLayout>

  <!-- Device Cards in this Room -->
  <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/roomDevicesRecyclerView"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:nestedScrollingEnabled="false"
      tools:listitem="@layout/item_device_card" />

</LinearLayout>
