import("//build_overrides/chip.gni")

source_set("closure-controller") {
  sources = [
    "ClosureController.cpp",
    "ClosureController.h",
    "OOBAccessors.cpp",
    "OOBAccessors.h",
  ]

  public_deps = [
    "${chip_root}/examples/all-devices-app/all-devices-common/binding-handler",
    "${chip_root}/examples/all-devices-app/all-devices-common/device/api:single-endpoint-device",
    "${chip_root}/examples/all-devices-app/all-devices-common/oob-accessors",
    "${chip_root}/src/app/clusters/bindings",
    "${chip_root}/src/lib/core",
    "${chip_root}/src/lib/support",
    "${chip_root}/src/platform",
    "${chip_root}/zzz_generated/app-common/clusters/ClosureControl",
    "${chip_root}/zzz_generated/app-common/clusters/ClosureDimension",
    "${chip_root}/zzz_generated/app-common/clusters/Identify",
    "${chip_root}/zzz_generated/app-common/clusters/shared:enums",
  ]

  deps = [ "${chip_root}/zzz_generated/app-common/devices" ]
}

source_set("posix") {
  sources = [
    "NamedPipeTranslators.cpp",
    "NamedPipeTranslators.h",
  ]

  public_deps = [
    ":closure-controller",
    "${chip_root}/examples/all-devices-app/posix/named_pipe",
  ]
}
