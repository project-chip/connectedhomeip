import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")

source_set("irrigation-system") {
  sources = [
    "Irrigation.cpp",
    "Irrigation.h",
  ]

  public_deps = [
    "${chip_root}/examples/all-devices-app/all-devices-common/device/api:device-interface",
    "${chip_root}/src/app/clusters/flow-measurement-server",
    "${chip_root}/src/app/clusters/identify-server",
    "${chip_root}/src/app/clusters/operational-state-server",
    "${chip_root}/src/app/clusters/valve-configuration-and-control-server",
    "${chip_root}/zzz_generated/app-common/devices/",
  ]
}

source_set("logging") {
  sources = [
    "impl/LoggingIrrigation.cpp",
    "impl/LoggingIrrigation.h",
    "impl/ValveConfigurations.cpp",
  ]

  public_deps = [
    ":irrigation-system",
    "${chip_root}/examples/all-devices-app/all-devices-common/device/types/water-valve",
  ]
}
