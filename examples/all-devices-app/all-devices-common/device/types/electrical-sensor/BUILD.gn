import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")

source_set("electrical-sensor") {
  sources = [
    "ElectricalSensor.cpp",
    "ElectricalSensor.h",
  ]

  public_deps = [
    "${chip_root}/examples/all-devices-app/all-devices-common/device/api:single-endpoint-device",
    "${chip_root}/src/app/clusters/electrical-energy-measurement-server",
    "${chip_root}/src/app/clusters/electrical-power-measurement-server",
    "${chip_root}/src/app/clusters/power-topology-server",
    "${chip_root}/src/data-model-providers/codedriven",
    "${chip_root}/src/lib/core:error",
    "${chip_root}/src/lib/support",
    "${chip_root}/zzz_generated/app-common/devices",
  ]
}

source_set("logging") {
  sources = [
    "impl/FakeReadings.cpp",
    "impl/FakeReadings.h",
    "impl/SimulatedElectricalSensor.cpp",
    "impl/SimulatedElectricalSensor.h",
  ]

  public_deps = [ ":electrical-sensor" ]
}
