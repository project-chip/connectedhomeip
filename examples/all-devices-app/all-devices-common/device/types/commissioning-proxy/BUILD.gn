import("//build_overrides/chip.gni")
import("${chip_root}/src/ble/ble.gni")
import("${chip_root}/src/platform/device.gni")

source_set("commissioning-proxy") {
  # The cluster, its transport-agnostic bookkeeping and the transport drivers all come
  # from the commissioning-proxy-server source_sets in deps below, so the example only
  # supplies the device wiring and the platform adapters.  This app has
  # no chip_data_model() rule, so CodegenIntegration.cpp is never compiled — it
  # wires the Ember/codegen path which this app does not use.
  sources = [
    "CommissioningProxyDevice.cpp",
    "CommissioningProxyDevice.h",
  ]

  deps = [
    "${chip_root}/examples/all-devices-app/all-devices-common/device/api:single-endpoint-device",
    "${chip_root}/src/app/clusters/commissioning-proxy-server",
    "${chip_root}/src/lib",
    "${chip_root}/zzz_generated/app-common/devices",
  ]

  if (chip_config_network_layer_ble) {
    # The BLE transport driver itself lives with the cluster in src/; this app supplies
    # only the platform adapter it needs (posix/linux/LinuxCommissioningProxyBleAdapter).
    # Public because CommissioningProxyDevice.h exposes both the transport and the
    # adapter interface to whoever constructs the device.
    public_deps = [
      "${chip_root}/src/app/clusters/commissioning-proxy-server:ble-transport",
    ]
  }

  include_dirs = [ "." ]
}
