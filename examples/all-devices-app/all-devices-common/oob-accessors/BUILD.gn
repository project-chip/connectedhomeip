import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")
import("${chip_root}/build/chip/buildconfig_header.gni")
import(
    "${chip_root}/examples/all-devices-app/all-devices-common/oob-accessors/all_devices_config.gni")

all_devices_app_buildconfig_header("all_devices_config_buildconfig") {
  header = "all_devices_config.h"
  header_dir = "app_config"
}

config("includes") {
  include_dirs = [ ".." ]
}

source_set("oob-accessors") {
  sources = [
    "InMemoryOOBAccessorRegistry.cpp",
    "InMemoryOOBAccessorRegistry.h",
    "NoopOOBAccessorRegistry.h",
    "OOBAccessor.h",
    "OOBAccessorRegistry.h",
    "OOBDataSerializer.cpp",
    "OOBDataSerializer.h",
  ]

  public_deps = [
    ":all_devices_config_buildconfig",
    "${chip_root}/src/app:paths",
    "${chip_root}/src/lib/core",
    "${chip_root}/src/lib/support",
  ]

  public_configs = [
    ":includes",
    "${chip_root}/src:includes",
  ]
}
