import("//build_overrides/chip.gni")

import("${chip_root}/build/chip/chip_test_suite.gni")
import("${chip_root}/build/chip/tests.gni")

if (chip_build_tests) {
  chip_test_suite("tests") {
    output_name = "TestOOBAccessors"

    test_sources = [
      "TestOOBAccessors.cpp",
      "TestOOBDataSerializer.cpp",
    ]

    cflags = [ "-Wconversion" ]

    public_deps = [
      "${chip_root}/examples/all-devices-app/all-devices-common/oob-accessors",
      "${chip_root}/examples/all-devices-app/all-devices-common/oob-accessors/clusters:ambient-context",
      "${chip_root}/examples/all-devices-app/all-devices-common/oob-accessors/clusters:basic-information",
      "${chip_root}/examples/all-devices-app/all-devices-common/oob-accessors/clusters:boolean-state",
      "${chip_root}/examples/all-devices-app/all-devices-common/oob-accessors/clusters:electrical-energy-measurement",
      "${chip_root}/examples/all-devices-app/all-devices-common/oob-accessors/clusters:mode-select",
      "${chip_root}/examples/all-devices-app/all-devices-common/oob-accessors/clusters:occupancy",
      "${chip_root}/examples/all-devices-app/all-devices-common/oob-accessors/clusters:on-off",
      "${chip_root}/examples/all-devices-app/all-devices-common/oob-accessors/clusters:rvc",
      "${chip_root}/src/app/server-cluster/testing",
      "${chip_root}/src/lib/support:testing",
      "${chip_root}/src/platform",
    ]
  }
}
