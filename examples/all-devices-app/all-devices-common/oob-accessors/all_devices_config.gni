import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")
import("${chip_root}/build/chip/buildconfig_header.gni")

declare_args() {
  all_devices_app_enable_named_pipes = (current_os != "freertos" && current_os != "zephyr")
  all_devices_app_enable_oob_accessors = (current_os != "freertos" && current_os != "zephyr")
}

template("all_devices_app_buildconfig_header") {
  buildconfig_header(target_name) {
    forward_variables_from(invoker,
                           [
                             "header",
                             "header_dir",
                           ])

    defines = [
      "ALL_DEVICES_APP_ENABLE_NAMED_PIPES=${all_devices_app_enable_named_pipes}",
      "ALL_DEVICES_APP_ENABLE_OOB_ACCESSORS=${all_devices_app_enable_oob_accessors}",
    ]
  }
}
