import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")
import("//build_overrides/jsoncpp.gni")

source_set("named_pipe") {
  sources = [
    "CommandTranslator.h",
    "Dispatcher.cpp",
    "Dispatcher.h",
    "translators/AmbientContextTranslator.cpp",
    "translators/AmbientContextTranslator.h",
    "translators/BasicInformationTranslator.cpp",
    "translators/BasicInformationTranslator.h",
    "translators/BooleanStateTranslator.cpp",
    "translators/BooleanStateTranslator.h",
    "translators/ElectricalEnergyMeasurementTranslator.cpp",
    "translators/ElectricalEnergyMeasurementTranslator.h",
    "translators/OccupancyTranslator.cpp",
    "translators/OccupancyTranslator.h",
    "translators/OnOffTranslator.cpp",
    "translators/OnOffTranslator.h",
    "translators/RvcTranslator.cpp",
    "translators/RvcTranslator.h",
  ]

  public_deps = [
    "${chip_root}/examples/all-devices-app/all-devices-common/oob-accessors",
    "${chip_root}/examples/platform/linux:named-pipes",
    "${chip_root}/src/lib/core",
    "${chip_root}/src/lib/support",
    "${chip_root}/src/platform",
    jsoncpp_root,
  ]

  public_configs = [ ":includes" ]
}

config("includes") {
  include_dirs = [ "${chip_root}/examples/all-devices-app" ]
}
