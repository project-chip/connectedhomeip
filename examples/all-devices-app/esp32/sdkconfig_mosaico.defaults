#    Description:
#      Local builds use this to select the ESP-Mosaico (ESP32-S31) for all-devices-app.
#
CONFIG_IDF_TARGET="esp32s31"
CONFIG_IDF_TARGET_ESP32S31=y
CONFIG_DEVICE_TYPE_ESP_MOSAICO=y

# ESP32-S31 is a preview target
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# Default to 921600 baud when flashing and monitoring device
CONFIG_ESPTOOLPY_BAUD_921600B=y
CONFIG_ESPTOOLPY_BAUD=921600
CONFIG_ESPTOOLPY_COMPRESSED=y
CONFIG_ESPTOOLPY_MONITOR_BAUD_115200B=y
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200

# Enable BT
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# Disable BT connection reattempt
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n

# Enable lwip ipv6 autoconfig
CONFIG_LWIP_IPV6_AUTOCONFIG=y

# Use a custom partition table sized for the 16MB flash on the Mosaico
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_16mb.csv"

# Vendor and product id
CONFIG_DEVICE_VENDOR_ID=0xFFF1
CONFIG_DEVICE_PRODUCT_ID=0x8001

# Main task needs more stack (5k)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=5120

# Everything the shell offers is on the touch UI, and its prompt would clutter the
# USB console
CONFIG_ENABLE_CHIP_SHELL=n

# The USB-C port is the USB OTG controller: early boot output goes to UART0, then
# MosaicoUsbConsole moves the console to a TinyUSB CDC device on USB-C
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_TINYUSB_CDC_ENABLED=y

# Enable lwIP route hooks
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

# Serial Flasher config
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Disable softap support by default
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# Enable HKDF in mbedtls
CONFIG_MBEDTLS_HKDF_C=y

# Move functions from IRAM to flash
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y

# Increase LwIP IPv6 address number
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6

# Disable Read Client (saves memory)
CONFIG_DISABLE_READ_CLIENT=y

# Reduce event logging buffer DRAM usage
CONFIG_EVENT_LOGGING_CRIT_BUFFER_SIZE=512
CONFIG_EVENT_LOGGING_INFO_BUFFER_SIZE=512
CONFIG_EVENT_LOGGING_DEBUG_BUFFER_SIZE=512

# Optimize Flash
CONFIG_NEWLIB_NANO_FORMAT=y

# Proximity Ranging support for BLE post-commissioning
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=n

# The UI is the point of this board: optimise for speed, as the Mosaico BSP
# examples do
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# Octal PSRAM holds the two full 480x480 RGB565 frame buffers
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
# Small allocations go to PSRAM too: the CHIP stack, LVGL and the NimBLE host make
# thousands of them, and the BLE controller needs the internal RAM they would take
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Synchronise flushes to the CO5300 tearing-effect line
CONFIG_BSP_CO5300_ENABLE_TE=y

# LVGL settings the BSP expects
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_DPI_DEF=130

# Let LVGL allocate from the IDF heap, which is backed by PSRAM here, instead of
# reserving its own 64kB pool in internal RAM.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y

# The commissioning screen renders the onboarding payload as a QR code.
CONFIG_LV_USE_QRCODE=y

# Navigation widgets
CONFIG_LV_USE_TABVIEW=y
CONFIG_LV_USE_MSGBOX=y

# Touch responsiveness: higher scroll threshold to avoid accidental scroll drag
CONFIG_LV_INDEV_DEF_SCROLL_LIMIT=20

# The default 40 dB is too quiet on the Mosaico speaker
CONFIG_CHIME_ATTENUATION_DB=6

# Dark theme; Montserrat 14/18/24/32 for caption, body, heading and title text
CONFIG_LV_THEME_DEFAULT_DARK=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_18=y
