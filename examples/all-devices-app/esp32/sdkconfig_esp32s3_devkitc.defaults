# ESP32-S3-DevKitC with an 8 MB flash module (N8 / N8R8), no display. Layer it on the
# base defaults:
#   idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig_esp32s3_devkitc.defaults" set-target esp32s3 build

CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y
CONFIG_DEVICE_TYPE_ESP32_S3_DEVKITC=y

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_8mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_8mb.csv"
