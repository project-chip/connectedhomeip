# Overlay for a Commissioning Proxy build. Layer it on a board's defaults file:
#   idf.py -D SDKCONFIG_DEFAULTS="<board>.defaults;sdkconfig_commissioning_proxy.defaults" ...

# The proxy opens BLE connections to commissionees, which needs the central role and
# the proxy scan hooks in the ESP32 BLE layer.
CONFIG_ENABLE_ESP32_BLE_CONTROLLER=y
CONFIG_ENABLE_ESP32_COMMISSIONING_PROXY=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y

# The proxy's BLE link to a commissionee is opened after the proxy itself is on a fabric,
# so BLE has to stay up after commissioning.
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=n

# One connection for the commissionee, one spare for the proxy's own commissioner.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2

# The commissioner tunnels through the proxy over a large-payload (TCP) CASE session, so
# the proxy has to run a TCP server and advertise it.
CONFIG_ENABLE_TCP_TRANSPORT=y
