DT_CHOSEN_IEEE802154 := zephyr,ieee802154

if CHIP

# Only enable the OpenThread L2 on boards that expose a 802.15.4 radio.
config NET_L2_OPENTHREAD
	default y if $(dt_chosen_enabled,$(DT_CHOSEN_IEEE802154))
	default n

choice STD_CPP
	default STD_CPP17
endchoice

config CHIP_ENABLE_PAIRING_AUTOSTART
	default y

config CHIP_OTA_REQUESTOR
	default n
	imply STREAM_FLASH
	imply STREAM_FLASH_ERASE

config IMG_MANAGER
	default y

config STREAM_FLASH
	default n

config STREAM_FLASH_ERASE
	default n

config BOOTLOADER_MCUBOOT
	default y

config BT
	default y

config BT_PERIPHERAL
	default y

config BT_DEVICE_NAME
	default "MatterAllDev"

config BT_HOST_CRYPTO
	default y

config MBEDTLS_ENTROPY_C
	default y

config MBEDTLS_PSA_DRIVER_GET_ENTROPY
	default y

config LOG
	default y

choice LOG_MODE
	default LOG_MODE_DEFERRED
endchoice

config SYSTEM_WORKQUEUE_STACK_SIZE
	default 4096

config THREAD_LOCAL_STORAGE
	default y

config MAIN_STACK_SIZE
	default 12288

choice POSIX_AEP_CHOICE
	default POSIX_AEP_CHOICE_NONE
endchoice

config MBEDTLS
	default y

choice CHIP_CRYPTO
	default CHIP_CRYPTO_PSA
endchoice

config MBEDTLS_HEAP_SIZE
	default 16384

config SHELL
	default y

config CHIP_LIB_SHELL
	default y


if SHELL

config SHELL_STACK_SIZE
    default 2616 if CHIP_WIFI

config SHELL_MINIMAL
    default y

config KERNEL_SHELL
    default n

config SHELL_WILDCARD
	default n

config SENSOR_SHELL
    default n

config DEVICE_SHELL
    default n

config DATE_SHELL
    default n

config DEVMEM_SHELL
    default n

config MCUBOOT_SHELL
    default n

config CLOCK_CONTROL_NRF_SHELL
    default n

config FLASH_SHELL
    default n

config HWINFO_SHELL
    default n

endif # SHELL

endif # CHIP
