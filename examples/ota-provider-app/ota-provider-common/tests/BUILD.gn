import("//build_overrides/chip.gni")
import("${chip_root}/build/chip/chip_test_suite.gni")

chip_test_suite("tests") {
  output_name = "libOTAProviderExampleTests"

  test_sources = [ "TestOTAProviderExample.cpp" ]

  cflags = [ "-Wconversion" ]

  # OTAProviderExample.cpp is compiled as part of ota-provider-common and pulls in the app
  # server (Server::GetInstance) and BDX at link time, so mirror the app's link deps.
  public_deps = [
    "${chip_root}/examples/ota-provider-app/ota-provider-common",
    "${chip_root}/src/app/clusters/ota-provider:user-consent",
    "${chip_root}/src/app/server",
    "${chip_root}/src/lib",
    "${chip_root}/src/protocols/bdx",
  ]
}
