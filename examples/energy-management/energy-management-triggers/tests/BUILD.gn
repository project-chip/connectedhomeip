import("//build_overrides/chip.gni")
import("${chip_root}/build/chip/chip_test_suite.gni")

chip_test_suite("tests") {
  import(
      "${chip_root}/src/app/clusters/device-energy-management-server/app_config_dependent_sources.gni")

  output_name = "TestDEMTestEventTriggers"

  test_sources = [ "TestDEMTestEventTriggers.cpp" ]

  sources = []
  foreach(file, app_config_dependent_sources) {
    sources += [
      "${chip_root}/src/app/clusters/device-energy-management-server/${file}",
    ]
  }
  sources += [
    "../DEMTestEventTriggers.cpp",
    "../FakeReadings.h",
  ]

  cflags = [ "-Wconversion" ]

  public_deps = [
    "${chip_root}/examples/energy-management/device-energy-management",
    "${chip_root}/src/app/clusters/general-diagnostics-server",
    "${chip_root}/src/app/server-cluster/testing",
    "${chip_root}/src/data-model-providers/codegen/tests:mock_model",
  ]
}
