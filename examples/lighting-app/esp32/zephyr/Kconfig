mainmenu "Matter ESP32-C6 Zephyr Lighting Example"

# Matter over Wi-Fi with the ESP32-native driver (no WPA supplicant)
config CHIP_WIFI
    bool
    default y
    select WIFI
    select WIFI_ESP32
    select NET_L2_ETHERNET
    imply NET_IPV4
    imply NET_DHCPV4

config CHIP_ENABLE_WIFI_STATION
    bool
    default y if CHIP_WIFI

rsource "Kconfig.defaults"

source "Kconfig.zephyr"
