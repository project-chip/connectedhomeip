import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")
import("//build_overrides/stm32_sdk.gni")
import("${build_root}/config/defaults.gni")

import("${chip_root}/src/platform/device.gni")
import("${stm32_sdk_build_root}/stm32_executable.gni")
import("${stm32_sdk_build_root}/stm32_sdk.gni")

assert(current_os == "freertos")

examples_plat_dir = "${chip_root}/examples/platform/stm32"
stm32_app_common = "${chip_root}/third_party/st/x-cube-matter/Projects/STM32WBA65I-DK1/Common/Application"
app_data_model =
    "${chip_root}/examples/lighting-app/stm32/data_model:stm32-lighting"

declare_args() {
  # Dump memory usage at link time.
  chip_print_memory_usage = false

  # Monitor & log memory usage at runtime.
  enable_heap_monitoring = true

  # Enable Sleepy end device
  enable_sleepy_device = false

  # OTA timeout in seconds
  OTA_periodic_query_timeout = 86400
}

if (chip_enable_ota_requestor) {
  # OEMiROT Secure_nsclib path
  oemirot_nsclib_path =
      "${examples_plat_dir}/STM32WBA65I-DK1/oemirot/Secure_nsclib"
  stm32_oemirot_ns_app = "${chip_root}/third_party/st/x-cube-matter/Projects/STM32WBA65I-DK1/Applications/ROT_Lighting_OEMiRoT/OEMiROT_Appli_TrustZone/NonSecure"
} else {
  stm32_app_src = "${chip_root}/third_party/st/x-cube-matter/Projects/STM32WBA65I-DK1/Applications/Matter/Lighting-App/Core"
}

# Sanity check
assert(!(chip_enable_wifi && chip_enable_thread))

# Prebuild action to preprocess the linker script for OEMiROT
if (chip_enable_ota_requestor) {
  action("preprocess_linker_script") {
    script = "${examples_plat_dir}/STM32WBA65I-DK1/oemirot/preprocess_ld.py"

    ldscript_in =
        "${examples_plat_dir}/ldscripts/STM32WBA65I-DK1_FLASH_NS.ld.in"
    ldscript_out = "${target_gen_dir}/STM32WBA65I-DK1_FLASH_NS.ld"

    sources = [
      "${oemirot_nsclib_path}/appli_flash_layout.h",
      "${oemirot_nsclib_path}/appli_region_defs.h",
      ldscript_in,
    ]

    outputs = [ ldscript_out ]

    args = [
      "--input",
      rebase_path(ldscript_in, root_build_dir),
      "--output",
      rebase_path(ldscript_out, root_build_dir),
      "--include-dir",
      rebase_path(oemirot_nsclib_path, root_build_dir),
      "--define",
      "STM32WBA65xx",
    ]
  }
}

stm32_sdk("sdk") {
  include_dirs = [
    "${chip_root}/src/platform/stm32",
    "${examples_plat_dir}",
    "${chip_root}/src/lib",
    "include",
    "${chip_root}/src/include",
  ]

  sources = [
    "${examples_plat_dir}/config_files/STM32WBA6/FreeRTOSConfig.h",
    "${examples_plat_dir}/config_files/STM32WBA6/matter_config.h",
    "include/CHIPProjectConfig.h",
  ]

  defines = [
    "BOARD_ID=${stm32_board}",
    "OTA_PERIODIC_TIMEOUT=${OTA_periodic_query_timeout}",
    "STM32STORE_MAX_KEY_SIZE=75",
  ]
}

stm32_executable("lighting_app") {
  deps = []

  output_name = "${stm32_board}-lighting.elf"
  defines = []

  sources = [
    "src/AppTask.cpp",
    "src/IdentifierEffect.cpp",
    "src/LightingManager.cpp",
    "src/SoftwareDiagnosticsTestEventTriggerHandler.cpp",
    "src/ZclCallbacks.cpp",
    "${stm32_app_common}/App/Src/app_entry.cpp",
  ]

  deps = [
    ":sdk",
    "${chip_root}/examples/providers:device_info_provider_please_do_not_reuse_as_is",
    "${chip_root}/src/app/clusters/network-commissioning:network-commissioning",
    "${chip_root}/src/lib",
    "${chip_root}/src/setup_payload",
    app_data_model,
  ]

  public = [
    "${chip_root}/src/platform/stm32/stm32wba/FactoryDataProvider.h",
    "${chip_root}/src/platform/stm32/stm32wba/OTAImageProcessorImpl.h",
  ]

  # Add the startup file to the target
  # OEMiROT TrustZone NonSecure configuration
  if (chip_enable_ota_requestor) {
    sources +=
        [ "${examples_plat_dir}/startup_files/startup_stm32wbaxx_oemirot.c" ]
  } else {
    sources += [ "${examples_plat_dir}/startup_files/startup_stm32wba65xx.s" ]
  }

  defines += [
    "DEBUG",
    "USE_HAL_DRIVER",
  ]

  if (chip_enable_ota_requestor) {
    defines += [ "STM32_OTA_ENABLED" ]
    sources += [
      "${stm32_oemirot_ns_app}/Core/Src/main.c",
      "${stm32_oemirot_ns_app}/Core/Src/stm32wbaxx_hal_msp.c",
      "${stm32_oemirot_ns_app}/Core/Src/stm32wbaxx_it.c",
      "${stm32_oemirot_ns_app}/Core/Src/syscalls.c",
      "${stm32_oemirot_ns_app}/Core/Src/sysmem.c",
      "${stm32_oemirot_ns_app}/Core/Src/system_stm32wbaxx.c",   
      "src/ota.cpp",
    ]
  } else  {
    sources += [
      "${stm32_app_src}/Src/main.c",
      "${stm32_app_src}/Src/stm32wbaxx_hal_msp.c",
      "${stm32_app_src}/Src/stm32wbaxx_it.c",
      "${stm32_app_src}/Src/syscalls.c",
      "${stm32_app_src}/Src/sysmem.c",
      "${stm32_app_src}/Src/system_stm32wbaxx.c",
    ]

  }

  # OEMiROT TrustZone NonSecure configuration
  if (chip_enable_ota_requestor) {
    # Add dependency on linker script preprocessing
    deps += [ ":preprocess_linker_script" ]

    # Use preprocessed TrustZone NonSecure linker script
    ldscript = "${target_gen_dir}/STM32WBA65I-DK1_FLASH_NS.ld"

    # Add Secure_nsclib include path
    include_dirs = [ oemirot_nsclib_path ]
  } else {
    # Standard linker script
    ldscript = "${examples_plat_dir}/ldscripts/STM32WBA65I-DK1_FLASH.ld"
  }

  inputs = [ ldscript ]

  ldflags = [
    "-T" + rebase_path(ldscript, root_build_dir),

    # other linker flags ...
    "-static",
    "-Wl,--cref",
    "-Wl,--start-group",
    "-lc",
    "-lm",
    "-lstdc++",
    "-lsupc++",
    "-Wl,--no-warn-rwx-segments",
    "-Wl,--end-group",
    "-Wl,--no-warn-execstack",
  ]

  # Link with secure_nsclib.o for OEMiROT TrustZone
  if (chip_enable_ota_requestor) {
    ldflags += [ rebase_path("${oemirot_nsclib_path}/secure_nsclib.o",
                             root_build_dir) ]
  }

  if (chip_print_memory_usage) {
    ldflags += [
      "-Wl,--print-memory-usage",
      "-fstack-usage",
    ]
  }

  output_dir = root_out_dir
}
group("stm32") {
  deps = [ ":lighting_app" ]
}

group("default") {
  deps = [ ":stm32" ]
}
