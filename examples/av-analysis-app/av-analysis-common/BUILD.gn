import("//build_overrides/chip.gni")
import("${chip_root}/src/app/chip_data_model.gni")

config("config") {
  include_dirs = [
    "include",
    "include/clusters/av-analysis",
    "include/clusters/webrtc-requestor",
    "include/webrtc-peer-controller",
  ]
}

chip_data_model("av-analysis-common") {
  zap_file = "av-analysis-app.zap"
  is_server = true
}

source_set("av-analysis-node-lib") {
  public_configs = [ ":config" ]

  sources = [
    "include/av-analysis-node-app.h",
    "include/clusters/av-analysis/av-analysis-delegate.h",
    "include/clusters/webrtc-requestor/webrtc-requestor-delegate.h",
    "include/webrtc-peer-controller/webrtc-peer-controller.h",
    "src/av-analysis-node-app.cpp",
    "src/clusters/webrtc-requestor/webrtc-requestor-delegate.cpp",
  ]

  deps = [
    "${chip_root}/examples/av-analysis-app/av-analysis-common",
    "${chip_root}/src/app/clusters/av-analysis-server",
    "${chip_root}/src/app/clusters/webrtc-transport-requestor-server",
    "${chip_root}/src/lib",
  ]
}
