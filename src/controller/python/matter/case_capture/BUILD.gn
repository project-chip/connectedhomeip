import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")

# What a CASE handshake is and where completed ones are held, with no
# dependency on the Python layer above. Separated out so it can be unit tested
# on its own: the rest of this directory is the ctypes-facing API, which needs
# the interpreter and the CHIP event loop.
source_set("case_handshake_metrics") {
  sources = [
    "CASEHandshakeMetricsBackend.h",
    "CASEHandshakeMetricsRecord.h",
    "CompletedCASEHandshakeQueue.cpp",
    "CompletedCASEHandshakeQueue.h",
  ]

  public_deps = [
    "${chip_root}/src/lib/address_resolve",
    "${chip_root}/src/lib/core",
    "${chip_root}/src/lib/support",
    "${chip_root}/src/protocols/secure_channel",
    "${chip_root}/src/system",
    "${chip_root}/src/tracing",
    "${chip_root}/src/transport",
  ]
}
