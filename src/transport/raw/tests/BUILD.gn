import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")
import("//build_overrides/pigweed.gni")
import("${chip_root}/src/inet/inet.gni")
import("${chip_root}/src/platform/device.gni")

import("${chip_root}/build/chip/chip_test_suite.gni")
import("${chip_root}/build/chip/fuzz_test.gni")
static_library("helpers") {
  output_name = "libNetworkTestHelpers"
  output_dir = "${root_out_dir}/lib"

  sources = [
    "NetworkTestHelpers.cpp",
    "NetworkTestHelpers.h",
    "TCPBaseTestAccess.h",
  ]

  cflags = [ "-Wconversion" ]

  public_deps = [
    "${chip_root}/src/inet/tests:helpers",
    "${chip_root}/src/transport/raw",
  ]
}

chip_test_suite("tests") {
  output_name = "libRawTransportTests"

  test_sources = [
    "TestMessageHeader.cpp",
    "TestPeerAddress.cpp",
    "TestProxyTransport.cpp",
    "TestUDP.cpp",
  ]

  # ESP32 QEMU enables TCP for the inet LwIP endpoint regression test. Avoid
  # broadening the QEMU suite with the raw TCP transport tests in that config.
  if (chip_inet_config_enable_tcp_endpoint && chip_device_platform != "esp32") {
    test_sources += [ "TestTCP.cpp" ]
  }

  if (chip_config_network_layer_ble) {
    test_sources += [ "TestBLEReinitialization.cpp" ]
  }

  public_deps = [
    ":helpers",
    "${chip_root}/src/inet/tests:helpers",
    "${chip_root}/src/lib/core",
    "${chip_root}/src/lib/core:string-builder-adapters",
    "${chip_root}/src/lib/support",
    "${chip_root}/src/lib/support:test_utils",
    "${chip_root}/src/transport",
    "${chip_root}/src/transport/raw",
  ]

  cflags = [ "-Wconversion" ]
}

if (pw_enable_fuzz_test_targets && chip_inet_config_enable_tcp_endpoint) {
  # Fuzzes TCP message framing (TCPBase::ProcessReceivedBuffer) with the byte
  # stream split across packet buffers at fuzzer-chosen points.
  chip_pw_fuzz_target("fuzz-tcp-framing-pw") {
    test_source = [ "FuzzTCPFramingPW.cpp" ]
    public_deps = [
      ":helpers",
      "${chip_root}/src/inet",
      "${chip_root}/src/lib/core",
      "${chip_root}/src/lib/core:string-builder-adapters",
      "${chip_root}/src/lib/support",
      "${chip_root}/src/platform",
      "${chip_root}/src/platform/logging:default",
      "${chip_root}/src/transport/raw",
    ]
  }
}
