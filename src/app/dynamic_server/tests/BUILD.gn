import("//build_overrides/chip.gni")
import("${chip_root}/build/chip/chip_test_suite.gni")
import("${chip_root}/src/app/common_flags.gni")
import("${chip_root}/src/tracing/tracing_args.gni")

assert(chip_build_controller_dynamic_server)

chip_test_suite("tests") {
  output_name = "libDynamicDispatcherTests"

  test_sources = [ "TestDynamicDispatcher.cpp" ]

  public_deps = [
    "${chip_root}/src/app",
    "${chip_root}/src/app/common:cluster-objects",
    "${chip_root}/src/protocols",
  ]

  if (matter_enable_tracing_support &&
      matter_trace_config ==
      "${chip_root}/src/tracing/perfetto:perfetto_tracing") {
    public_deps += [ "${chip_root}/src/tracing/perfetto:event_storage" ]
  }
}
