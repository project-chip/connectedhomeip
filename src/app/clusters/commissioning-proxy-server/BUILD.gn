import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")
import("${chip_root}/src/ble/ble.gni")

source_set("commissioning-proxy-server") {
  # The cluster and its subsystems are independent of the application
  # configuration: the transports the cluster advertises come from the drivers
  # registered at runtime, not from build flags. Only the code-generation
  # integration is application-config dependent, so CodegenIntegration.{cpp,h}
  # is listed in app_config_dependent_sources.{gni,cmake} instead.
  sources = [
    "CommissioningProxyBgScanRegistry.cpp",
    "CommissioningProxyBgScanRegistry.h",
    "CommissioningProxyCluster.cpp",
    "CommissioningProxyCluster.h",
    "CommissioningProxyScanAggregator.cpp",
    "CommissioningProxyScanAggregator.h",
    "CommissioningProxyScanCache.cpp",
    "CommissioningProxyScanCache.h",
    "CommissioningProxySessionManager.cpp",
    "CommissioningProxySessionManager.h",
    "CommissioningProxyTransport.h",
  ]

  cflags = [ "-Wconversion" ]

  public_deps = [
    "${chip_root}/src/app/data-model-provider",
    "${chip_root}/src/app/server",
    "${chip_root}/src/app/server-cluster",
    "${chip_root}/src/app/server-cluster:registry",
    "${chip_root}/src/data-model-providers/codegen:headers",
    "${chip_root}/src/lib/support:timer-delegate",
    "${chip_root}/src/messaging",
    "${chip_root}/src/platform",
    "${chip_root}/zzz_generated/app-common/clusters/CommissioningProxy",
  ]
}

# BLE (BTP) transport driver. Split out so an application that proxies over another
# transport only - or a platform with no BLE stack - can depend on
# commissioning-proxy-server without pulling in src/ble. The platform hooks it needs
# come from CommissioningProxyBleAdapter, which the application implements.
#
# Only defined when BLE is enabled: src/ble builds BLEEndPoint and BleLayer only under
# the same condition, so on a no-BLE platform this driver would reference symbols that
# were never compiled.
if (chip_config_network_layer_ble) {
  source_set("ble-transport") {
    sources = [
      "CommissioningProxyBleAdapter.h",
      "CommissioningProxyBleTransport.cpp",
      "CommissioningProxyBleTransport.h",
    ]

    cflags = [ "-Wconversion" ]

    public_deps = [
      ":commissioning-proxy-server",
      "${chip_root}/src/ble",
    ]
  }
}

# Wi-Fi PAF (PAFTP) transport driver. Split out for the same reason as ble-transport: an
# application that proxies over BLE only - or a platform with no Wi-Fi PAF stack - can
# depend on commissioning-proxy-server without pulling in src/wifipaf. The platform
# discovery hooks it needs come from CommissioningProxyPafAdapter, which the application
# implements.
source_set("paf-transport") {
  sources = [
    "CommissioningProxyPafAdapter.h",
    "CommissioningProxyPafTransport.cpp",
    "CommissioningProxyPafTransport.h",
  ]

  cflags = [ "-Wconversion" ]

  public_deps = [
    ":commissioning-proxy-server",
    "${chip_root}/src/wifipaf",
  ]
}
