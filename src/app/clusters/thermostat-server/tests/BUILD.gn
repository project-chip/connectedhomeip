import("//build_overrides/chip.gni")
import("${chip_root}/build/chip/chip_test_suite.gni")
import("${chip_root}/src/app/common_flags.gni")

# ThermostatCluster.cpp is Ember/codegen-based and needs a static per-app zap config to supply
# MATTER_DM_THERMOSTAT_CLUSTER_SERVER_ENDPOINT_COUNT (via zap-generated/gen_config.h). The
# controller-only builds (Android JNI, Darwin framework, Python controller) use a dynamic
# endpoint architecture instead and skip that header entirely (see
# CHIP_CONFIG_SKIP_APP_SPECIFIC_GENERATED_HEADER_INCLUDES in src/app/util/config.h), so this
# source can't be compiled there; skip this test under that configuration.
if (!chip_build_controller_dynamic_server) {
  # ThermostatAttrAccess is a single class whose methods are defined across several .cpp files in
  # ../ (it is gated behind app_config_dependent_sources.gni rather than the thermostat-server
  # source_set, since it is only built into apps that include a Thermostat endpoint). Linking any
  # one translation unit therefore requires pulling in all of them here.
  source_set("thermostat-server-schedule-test-srcs") {
    sources = [
      "${chip_root}/src/app/clusters/thermostat-server/PresetStructWithOwnedMembers.cpp",
      "${chip_root}/src/app/clusters/thermostat-server/PresetStructWithOwnedMembers.h",
      "${chip_root}/src/app/clusters/thermostat-server/ScheduleStructWithOwnedMembers.cpp",
      "${chip_root}/src/app/clusters/thermostat-server/ScheduleStructWithOwnedMembers.h",
      "${chip_root}/src/app/clusters/thermostat-server/Setpoint.cpp",
      "${chip_root}/src/app/clusters/thermostat-server/Setpoint.h",
      "${chip_root}/src/app/clusters/thermostat-server/SetpointAttributes.cpp",
      "${chip_root}/src/app/clusters/thermostat-server/SetpointAttributes.h",
      "${chip_root}/src/app/clusters/thermostat-server/SetpointLimits.h",
      "${chip_root}/src/app/clusters/thermostat-server/SetpointRange.h",
      "${chip_root}/src/app/clusters/thermostat-server/Setpoints.cpp",
      "${chip_root}/src/app/clusters/thermostat-server/Setpoints.h",
      "${chip_root}/src/app/clusters/thermostat-server/Temperature.h",
      "${chip_root}/src/app/clusters/thermostat-server/ThermostatCluster.cpp",
      "${chip_root}/src/app/clusters/thermostat-server/ThermostatCluster.h",
      "${chip_root}/src/app/clusters/thermostat-server/ThermostatClusterAtomic.cpp",
      "${chip_root}/src/app/clusters/thermostat-server/ThermostatClusterEvents.cpp",
      "${chip_root}/src/app/clusters/thermostat-server/ThermostatClusterEvents.h",
      "${chip_root}/src/app/clusters/thermostat-server/ThermostatClusterPresets.cpp",
      "${chip_root}/src/app/clusters/thermostat-server/ThermostatClusterPresets.h",
      "${chip_root}/src/app/clusters/thermostat-server/ThermostatClusterSchedules.cpp",
      "${chip_root}/src/app/clusters/thermostat-server/ThermostatClusterSchedules.h",
      "${chip_root}/src/app/clusters/thermostat-server/ThermostatClusterSetpoints.cpp",
      "${chip_root}/src/app/clusters/thermostat-server/ThermostatClusterSetpoints.h",
      "${chip_root}/src/app/clusters/thermostat-server/ThermostatClusterSuggestions.cpp",
      "${chip_root}/src/app/clusters/thermostat-server/ThermostatDelegate.h",
      "${chip_root}/src/app/clusters/thermostat-server/ThermostatSuggestionStructWithOwnedMembers.cpp",
      "${chip_root}/src/app/clusters/thermostat-server/ThermostatSuggestionStructWithOwnedMembers.h",
      "ThermostatAttrAccessTestAccess.h",
      "ThermostatClusterTestStubs.cpp",
    ]

    public_deps = [
      "${chip_root}/src/app",
      "${chip_root}/src/app/common:cluster-objects",
      "${chip_root}/src/app/server",
      "${chip_root}/src/app/tests:app-test-stubs",
      "${chip_root}/src/app/util/mock:mock_codegen_data_model",
      "${chip_root}/src/app/util/mock:mock_ember",
      "${chip_root}/src/lib/core",
      "${chip_root}/src/lib/support",
      "${chip_root}/zzz_generated/app-common/clusters/Thermostat",
    ]
  }

  chip_test_suite("tests") {
    output_name = "TestThermostatServerSchedules"

    test_sources = [
      "TestScheduleStructWithOwnedMembers.cpp",
      "TestThermostatClusterSchedules.cpp",
    ]

    public_deps = [
      ":thermostat-server-schedule-test-srcs",
      "${chip_root}/src/lib/support",
    ]
  }
} else {
  # Keep the ":tests" label buildable (with the ".lib"/"_run" sub-targets chip_test_group.gni
  # expects of every entry in //src:tests) without actually compiling anything.
  chip_test_suite("tests") {
    output_name = "TestThermostatServerSchedules"
  }
}
