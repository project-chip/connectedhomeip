import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")
import("//build_overrides/pigweed.gni")

import("${chip_root}/build/chip/chip_test_suite.gni")

# BDXDownloader and DefaultOTARequestor are app-config-dependent sources, so
# they are not part of the ota-requestor source set and are compiled here for
# the download tests.
source_set("default-ota-requestor-test-srcs") {
  sources = [
    "${chip_root}/src/app/clusters/ota-requestor/BDXDownloader.cpp",
    "${chip_root}/src/app/clusters/ota-requestor/BDXDownloader.h",
    "${chip_root}/src/app/clusters/ota-requestor/CodegenIntegrationInternal.h",
    "${chip_root}/src/app/clusters/ota-requestor/DefaultOTARequestor.cpp",
    "${chip_root}/src/app/clusters/ota-requestor/DefaultOTARequestor.h",
  ]

  public_deps = [
    "${chip_root}/src/app/clusters/ota-requestor",
    "${chip_root}/src/app/server",
    "${chip_root}/src/platform",
    "${chip_root}/src/protocols/bdx",
  ]
}

chip_test_suite("tests") {
  output_name = "TestOTARequestorCluster"

  test_sources = [
    "TestDefaultOTARequestorDownload.cpp",
    "TestOTARequestorAttributes.cpp",
    "TestOTARequestorCluster.cpp",
  ]

  sources = []

  cflags = [ "-Wconversion" ]

  public_deps = [
    ":default-ota-requestor-test-srcs",
    "${chip_root}/src/app/clusters/ota-requestor",
    "${chip_root}/src/app/data-model-provider/tests:encode-decode",
    "${chip_root}/src/app/server-cluster/testing",
    "${chip_root}/src/lib/support",
    "${chip_root}/src/lib/support:testing",
    "${chip_root}/src/messaging/tests:helpers",
  ]
}
