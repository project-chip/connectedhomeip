import("//build_overrides/chip.gni")
import("${chip_root}/src/app/common_flags.gni")

source_set("groups-cluster") {
  sources = [
    "GroupsCluster.cpp",
    "GroupsCluster.h",
  ]

  public_deps = [
    "${chip_root}/src/app/clusters/access-control-server:access-control-event-helper",
    "${chip_root}/src/app/clusters/identify-server:delegates",
    "${chip_root}/src/app/clusters/scenes-server:scenes",
    "${chip_root}/src/app/server-cluster",
    "${chip_root}/src/credentials",
    "${chip_root}/src/tracing:macros",
    "${chip_root}/zzz_generated/app-common/clusters/GroupKeyManagement",
    "${chip_root}/zzz_generated/app-common/clusters/Groups",
  ]
}

source_set("stubbed-groups-cluster") {
  sources = [
    "StubbedGroupsCluster.cpp",
    "StubbedGroupsCluster.h",
  ]

  public_deps = [
    "${chip_root}/src/app/clusters/access-control-server:access-control-event-helper",
    "${chip_root}/src/app/server-cluster",
    "${chip_root}/src/credentials",
    "${chip_root}/src/tracing:macros",
    "${chip_root}/zzz_generated/app-common/clusters/Groups",
  ]
}

group("groups-server") {
  if (chip_config_use_stubbed_groups_cluster) {
    public_deps = [ ":stubbed-groups-cluster" ]
  } else {
    public_deps = [ ":groups-cluster" ]
  }
}
