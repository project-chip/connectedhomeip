import("//build_overrides/build.gni")
import("${build_root}/config/sysroot.gni")
import("crypto.gni")

# Share the selection with dependencies that build their own OpenSSL consumers.
openssl_root = chip_openssl_root
if (openssl_root == "" && current_os == "linux" && current_cpu == host_cpu &&
    sysroot == "") {
  # The image's private host installation must not override a cross sysroot.
  openssl_root = getenv("CHIP_OPENSSL_ROOT")
}
