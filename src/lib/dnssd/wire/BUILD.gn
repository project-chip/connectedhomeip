import("//build_overrides/chip.gni")

static_library("wire") {
  sources = [
    "BytesRange.h",
    "Constants.h",
    "DnsHeader.h",
    "FlatAllocatedQName.h",
    "HeapQName.h",
    "QName.cpp",
    "QName.h",
    "QNameString.cpp",
    "QNameString.h",
    "RecordWriter.cpp",
    "RecordWriter.h",
  ]

  public_deps = [
    "${chip_root}/src/inet",
    "${chip_root}/src/lib/core",
    "${chip_root}/src/lib/support:span",
  ]
}

# Lib for the decoding of DNS messages received off the wire. Split from ":wire" so that
# write-only users, or users that only build messages, do not need to pull in the parser.
static_library("reader") {
  sources = [
    "Parser.cpp",
    "Parser.h",
    "Query.h",
    "RecordData.cpp",
    "RecordData.h",
  ]

  public_deps = [
    ":wire",
    "${chip_root}/src/inet",
    "${chip_root}/src/lib/core",
  ]

  cflags = [ "-Wconversion" ]
}
