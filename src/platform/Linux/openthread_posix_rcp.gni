declare_args() {
  # Drive a real 802.15.4 radio co-processor (RCP) over spinel via OpenThread's
  # POSIX platform instead of the UDP simulation radio. Only meaningful with the
  # embedded-OpenThread build (chip_system_config_use_openthread_inet_endpoints).
  #
  # Declared in its own .gni because two independent targets must agree on which
  # OpenThread platform library is linked: src/platform/Linux (the CHIP OpenThread
  # glue) and examples/platform/linux:app-main. If only one selected the POSIX
  # platform, both it and the simulation platform would link and their otPlatRadio*
  # symbols would collide.
  chip_openthread_linux_use_posix_rcp = false
}
