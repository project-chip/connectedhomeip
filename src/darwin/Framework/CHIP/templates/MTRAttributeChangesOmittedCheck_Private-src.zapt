{{> header excludeZapComment=true}}

#import "MTRAttributeChangesOmittedCheck.h"

#include <app-common/zap-generated/ids/Attributes.h>
#include <app-common/zap-generated/ids/Clusters.h>

using namespace chip;
using namespace chip::app;

{{#zcl_clusters}}
{{#if (isInConfigList (asUpperCamelCase name preserveAcronyms=true) "DarwinPrivateClusters")}}
{{#if (isSupported (asUpperCamelCase name preserveAcronyms=true))}}
#if MTR_INCLUDE_CLUSTER_{{asDelimitedMacro (asUpperCamelCase name preserveAcronyms=true)}}
static BOOL AttributeHasChangesOmittedQualityIn{{asUpperCamelCase name preserveAcronyms=true}}Cluster(AttributeId aAttributeId)
{
    using namespace Clusters::{{asUpperCamelCase name}};
    switch (aAttributeId) {
        {{#zcl_attributes_server}}
        {{#if (and (isSupported (asUpperCamelCase ../name preserveAcronyms=true) attribute=(asUpperCamelCase name preserveAcronyms=true))
                   isChangeOmitted)}}
        case Attributes::{{asUpperCamelCase name}}::Id: {
            return YES;
        }
        {{/if}}
        {{/zcl_attributes_server}}
        default: {
            return NO;
        }
    }
}
#endif
{{/if}}
{{/if}}
{{/zcl_clusters}}

{{#zcl_clusters}}
{{#if (isInConfigList (asUpperCamelCase name preserveAcronyms=true) "DarwinClustersWithPrivateExtensions")}}
{{#if (isSupported (asUpperCamelCase name preserveAcronyms=true))}}
#if MTR_INCLUDE_CLUSTER_EXTENSION_{{asDelimitedMacro (asUpperCamelCase name preserveAcronyms=true)}}
static BOOL PrivateAttributeHasChangesOmittedQualityIn{{asUpperCamelCase name preserveAcronyms=true}}Cluster(AttributeId aAttributeId)
{
    using namespace Clusters::{{asUpperCamelCase name}};
    switch (aAttributeId) {
        {{#zcl_attributes_server}}
        {{#if manufacturerCode}}
        {{#if (and (isSupported (asUpperCamelCase ../name preserveAcronyms=true) attribute=(asUpperCamelCase name preserveAcronyms=true))
                   isChangeOmitted)}}
        case Attributes::{{asUpperCamelCase name}}::Id: {
            return YES;
        }
        {{/if}}
        {{/if}}
        {{/zcl_attributes_server}}
        default: {
            return NO;
        }
    }
}
#endif
{{/if}}
{{/if}}
{{/zcl_clusters}}

BOOL MTRPrivateAttributeHasChangesOmittedQuality(ClusterId aClusterId, AttributeId aAttributeId)
{
    switch (aClusterId)
    {
        {{#zcl_clusters}}
        {{#if (isInConfigList (asUpperCamelCase name preserveAcronyms=true) "DarwinPrivateClusters")}}
        {{#if (isSupported (asUpperCamelCase name preserveAcronyms=true))}}
#if MTR_INCLUDE_CLUSTER_{{asDelimitedMacro (asUpperCamelCase name preserveAcronyms=true)}}
        case Clusters::{{asUpperCamelCase name}}::Id: {
            return AttributeHasChangesOmittedQualityIn{{asUpperCamelCase name preserveAcronyms=true}}Cluster(aAttributeId);
        }
#endif
        {{/if}}
        {{/if}}
        {{/zcl_clusters}}
        {{#zcl_clusters}}
        {{#if (isInConfigList (asUpperCamelCase name preserveAcronyms=true) "DarwinClustersWithPrivateExtensions")}}
        {{#if (isSupported (asUpperCamelCase name preserveAcronyms=true))}}
#if MTR_INCLUDE_CLUSTER_EXTENSION_{{asDelimitedMacro (asUpperCamelCase name preserveAcronyms=true)}}
        case Clusters::{{asUpperCamelCase name}}::Id: {
            return PrivateAttributeHasChangesOmittedQualityIn{{asUpperCamelCase name preserveAcronyms=true}}Cluster(aAttributeId);
        }
#endif
        {{/if}}
        {{/if}}
        {{/zcl_clusters}}
        default: {
            return NO;
        }
    }
}
