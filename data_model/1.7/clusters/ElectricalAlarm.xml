    <bitmap name="AlarmBitmap">
      <bitfield name="OverVoltage" bit="0" summary="The voltage exceeds the defined threshold">
        <mandatoryConform>
          <feature name="OVERVOLT"/>
        </mandatoryConform>
      </bitfield>
      <bitfield name="UnderVoltage" bit="1" summary="The voltage drops below the defined threshold">
        <mandatoryConform>
          <feature name="UNDERVOLT"/>
        </mandatoryConform>
      </bitfield>
      <bitfield name="OverFrequency" bit="2" summary="The frequency exceeds the defined threshold">
