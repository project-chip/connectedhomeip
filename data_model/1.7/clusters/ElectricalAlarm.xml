        </mandatoryConform>
      </bitfield>
      <bitfield name="UnderFrequency" bit="3" summary="The frequency drops below the defined threshold">
        <mandatoryConform>
          <feature name="UNDERFREQ"/>
        </mandatoryConform>
      </bitfield>
      <bitfield name="OverPower" bit="4" summary="The power draw exceeds the defined threshold">
