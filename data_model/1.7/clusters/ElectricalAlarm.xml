      </bitfield>
      <bitfield name="PowerExported" bit="14" summary="Power is currently being exported above the defined threshold">
        <mandatoryConform>
          <feature name="POWEREXP"/>
        </mandatoryConform>
      </bitfield>
    </bitmap>
