  <classification hierarchy="derived" baseCluster="Alarm Base" role="utility" picsCode="ESALM" scope="Endpoint"/>
  <features>
    <feature bit="20" code="ADJUST" name="AdjustableThresholds" summary="Supports the ability to adjust the thresholds of alarms">
      <optionalConform/>
    </feature>
    <feature bit="21" code="OVERVOLT" name="OverVoltage" summary="Supports activating alarms when a voltage measurement exceeds a threshold">
      <optionalConform choice="a" more="true" min="1"/>
    </feature>
    <feature bit="22" code="UNDERVOLT" name="UnderVoltage" summary="Supports activating alarms when a voltage measurement falls below a threshold">
      <optionalConform choice="a" more="true" min="1"/>
    </feature>
    <feature bit="23" code="OVERFREQ" name="OverFrequency" summary="Supports activating alarms when a frequency measurement exceeds a threshold">
      <optionalConform choice="a" more="true" min="1"/>
    </feature>
    <feature bit="24" code="UNDERFREQ" name="UnderFrequency" summary="Supports activating alarms when a frequency measurement falls below a threshold">
      <optionalConform choice="a" more="true" min="1"/>
    </feature>
    <feature bit="25" code="OVERPOWER" name="OverPower" summary="Supports activating alarms when a power measurement exceeds a threshold">
      <optionalConform choice="a" more="true" min="1"/>
    </feature>
    <feature bit="26" code="UNDERPOWER" name="UnderPower" summary="Supports activating alarms when a power measurement falls below a threshold">
      <optionalConform choice="a" more="true" min="1"/>
    </feature>
    <feature bit="27" code="OVERCUR" name="OverCurrent" summary="Supports activating alarms when a current measurement exceeds a threshold">
      <optionalConform choice="a" more="true" min="1"/>
    </feature>
    <feature bit="28" code="UNDERCUR" name="UnderCurrent" summary="Supports activating alarms when a current measurement falls below a threshold">
      <optionalConform choice="a" more="true" min="1"/>
    </feature>
    <feature bit="29" code="POWERIMP" name="PowerImport" summary="Supports activating alarms when power imported measurement exceeds a threshold">
      <optionalConform choice="a" more="true" min="1"/>
    </feature>
    <feature bit="30" code="POWEREXP" name="PowerExport" summary="Supports activating alarms when power exported measurement falls below a threshold">
      <optionalConform choice="a" more="true" min="1"/>
    </feature>
  </features>
