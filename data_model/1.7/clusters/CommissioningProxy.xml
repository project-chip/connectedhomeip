<cluster xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="types types.xsd cluster cluster.xsd" id="0x0455" name="Commissioning Proxy Cluster" revision="1">
  <revisionHistory>
    <revision revision="1" summary="Initial revision"/>
  </revisionHistory>
  <clusterIds>
    <clusterId id="0x0455" name="Commissioning Proxy">
      <provisionalConform/>
    </clusterId>
  </clusterIds>
  <classification hierarchy="base" role="application" picsCode="COMPRO" scope="Endpoint"/>
  <features>
    <feature bit="0" code="WI" name="WiFiNetworkInterface" summary="Wi-Fi related features">
      <optionalConform/>
    </feature>
    <feature bit="1" code="BGS" name="BackgroundScan" summary="Background scan">
      <optionalConform/>
    </feature>
  </features>
  <dataTypes>
    <bitmap name="CapabilitiesBitmap">
      <bitfield name="BLE" bit="1" summary="BTP transport is supported">
        <optionalConform choice="a" more="true" min="1"/>
      </bitfield>
      <bitfield name="WiFiPAF" bit="3" summary="PAFTP transport is supported">
        <optionalConform choice="a" more="true" min="1"/>
      </bitfield>
      <bitfield name="NTL" bit="4" summary="NTL transport is supported">
        <optionalConform choice="a" more="true" min="1"/>
      </bitfield>
    </bitmap>
    <bitmap name="WiFiBandBitmap">
      <bitfield name="2G4" bit="0" summary="2.4GHz - 2.401GHz to 2.495GHz (802.11b/g/n/ax)">
        <optionalConform choice="b" more="true" min="1">
          <feature name="WI"/>
        </optionalConform>
      </bitfield>
      <bitfield name="5G" bit="2" summary="5GHz - 5.150GHz to 5.895GHz (802.11a/n/ac/ax)">
        <optionalConform choice="b" more="true" min="1">
          <feature name="WI"/>
        </optionalConform>
      </bitfield>
    </bitmap>
    <struct name="ScanResultStruct">
      <field id="0" name="Address" type="octstr">
        <quality nullable="true"/>
        <mandatoryConform/>
        <constraint>
          <maxLength value="100"/>
        </constraint>
      </field>
      <field id="1" name="Transport" type="CapabilitiesBitmap">
        <mandatoryConform/>
        <constraint>
          <desc/>
        </constraint>
      </field>
      <field id="2" name="Discriminator" type="uint16">
        <mandatoryConform/>
        <constraint>
          <max value="4095"/>
        </constraint>
      </field>
      <field id="3" name="VendorID" type="vendor-id">
        <mandatoryConform/>
      </field>
      <field id="4" name="ProductID" type="uint16">
        <mandatoryConform/>
      </field>
      <field id="5" name="ExtendedData" type="octstr">
        <quality nullable="true"/>
        <mandatoryConform/>
        <constraint>
          <maxLength value="128"/>
        </constraint>
      </field>
      <field id="6" name="WiFiBand" type="WiFiBandBitmap" default="2">
        <optionalConform>
          <feature name="WI"/>
        </optionalConform>
      </field>
    </struct>
  </dataTypes>
  <attributes>
    <attribute id="0x0000" name="Transport" type="CapabilitiesBitmap">
      <access read="true" readPrivilege="view"/>
      <quality persistence="fixed"/>
      <mandatoryConform/>
      <constraint>
        <min value="1"/>
      </constraint>
    </attribute>
    <attribute id="0x0001" name="ScanMaxTime" type="uint8">
      <access read="true" write="true" readPrivilege="view" writePrivilege="operate"/>
      <mandatoryConform/>
      <constraint>
        <min value="1"/>
      </constraint>
    </attribute>
    <attribute id="0x0002" name="MaxSessions" type="uint8">
      <access read="true" readPrivilege="view"/>
      <quality persistence="fixed"/>
      <mandatoryConform/>
      <constraint>
        <min value="1"/>
      </constraint>
    </attribute>
    <attribute id="0x0003" name="MaxCachedResults" type="uint8">
      <access read="true" readPrivilege="view"/>
      <quality persistence="fixed"/>
      <mandatoryConform>
        <feature name="BGS"/>
      </mandatoryConform>
      <constraint>
        <min value="1"/>
      </constraint>
    </attribute>
    <attribute id="0x0004" name="NumCachedResults" type="uint8">
      <access read="true" readPrivilege="view"/>
      <mandatoryConform>
        <feature name="BGS"/>
      </mandatoryConform>
    </attribute>
    <attribute id="0x0005" name="CacheTimeout" type="uint16">
      <access read="true" write="true" readPrivilege="view" writePrivilege="operate"/>
      <mandatoryConform>
        <feature name="BGS"/>
      </mandatoryConform>
      <constraint>
        <min value="1"/>
      </constraint>
    </attribute>
    <attribute id="0x0006" name="CachedResults" type="list">
      <entry type="ScanResultStruct"/>
      <access read="true" readPrivilege="view"/>
      <quality nullable="true"/>
      <mandatoryConform>
        <feature name="BGS"/>
      </mandatoryConform>
      <constraint>
        <maxCount value="255"/>
      </constraint>
    </attribute>
    <attribute id="0x0007" name="WiFiBand" type="WiFiBandBitmap" default="2">
      <access read="true" readPrivilege="view"/>
      <quality persistence="fixed"/>
      <optionalConform>
        <feature name="WI"/>
      </optionalConform>
      <constraint>
        <desc/>
      </constraint>
    </attribute>
  </attributes>
  <commands>
    <command id="0x00" name="ProxyConnectRequest" direction="commandToServer" response="ProxyConnectResponse">
      <quality largeMessage="true"/>
      <access invokePrivilege="operate" fabricScoped="true"/>
      <mandatoryConform/>
      <field id="0" name="Address" type="octstr">
        <quality nullable="true"/>
        <mandatoryConform/>
        <constraint>
          <maxLength value="100"/>
        </constraint>
      </field>
      <field id="1" name="Transport" type="CapabilitiesBitmap">
        <mandatoryConform/>
        <constraint>
          <desc/>
        </constraint>
      </field>
      <field id="2" name="Discriminator" type="uint16">
        <mandatoryConform/>
        <constraint>
          <between>
            <from value="0"/>
            <to value="4095"/>
          </between>
        </constraint>
      </field>
      <field id="3" name="VendorID" type="vendor-id">
        <mandatoryConform/>
      </field>
      <field id="4" name="ProductID" type="uint16">
        <mandatoryConform/>
      </field>
      <field id="5" name="Timeout" type="uint16">
        <mandatoryConform/>
      </field>
      <field id="6" name="WiFiBand" type="WiFiBandBitmap" default="2">
        <optionalConform>
          <feature name="WI"/>
        </optionalConform>
      </field>
    </command>
    <command id="0x01" name="ProxyConnectResponse" direction="responseFromServer">
      <quality largeMessage="true"/>
      <mandatoryConform/>
      <field id="0" name="SessionID" type="uint16">
        <mandatoryConform/>
        <constraint>
          <max value="65534"/>
        </constraint>
      </field>
    </command>
    <command id="0x02" name="ProxyDisconnectRequest" direction="commandToServer" response="Y">
      <quality largeMessage="true"/>
      <access invokePrivilege="operate" fabricScoped="true"/>
      <mandatoryConform/>
      <field id="0" name="SessionID" type="uint16">
        <quality nullable="true"/>
        <mandatoryConform/>
        <constraint>
          <max value="65534"/>
        </constraint>
      </field>
    </command>
    <command id="0x03" name="ProxyScanRequest" direction="commandToServer" response="ProxyScanResponse">
      <quality largeMessage="true"/>
      <access invokePrivilege="operate"/>
      <mandatoryConform/>
      <field id="0" name="Transport" type="CapabilitiesBitmap">
        <mandatoryConform/>
      </field>
      <field id="1" name="WiFiBands" type="WiFiBandBitmap" default="2">
        <optionalConform>
          <feature name="WI"/>
        </optionalConform>
      </field>
    </command>
    <command id="0x04" name="ProxyScanResponse" direction="responseFromServer">
      <quality largeMessage="true"/>
      <mandatoryConform/>
      <field id="0" name="NumberOfResults" type="uint8">
        <mandatoryConform/>
      </field>
      <field id="1" name="ProxyScanResult" type="list">
        <entry type="ScanResultStruct"/>
        <mandatoryConform/>
        <constraint>
          <maxCount>
            <attribute name="MaxCachedResults"/>
          </maxCount>
        </constraint>
      </field>
    </command>
    <command id="0x05" name="ProxyBackGroundScanStartRequest" direction="commandToServer" response="Y">
      <access invokePrivilege="operate"/>
      <mandatoryConform>
        <feature name="BGS"/>
      </mandatoryConform>
      <field id="0" name="Transport" type="CapabilitiesBitmap">
        <mandatoryConform/>
      </field>
      <field id="1" name="Timeout" type="uint16">
        <mandatoryConform/>
      </field>
      <field id="2" name="WiFiBands" type="WiFiBandBitmap" default="2">
        <optionalConform>
          <feature name="WI"/>
        </optionalConform>
      </field>
    </command>
    <command id="0x06" name="ProxyBackGroundScanStopRequest" direction="commandToServer" response="Y">
      <access invokePrivilege="operate"/>
      <mandatoryConform>
        <feature name="BGS"/>
      </mandatoryConform>
      <field id="0" name="Transport" type="CapabilitiesBitmap">
        <mandatoryConform/>
      </field>
      <field id="1" name="WiFiBands" type="WiFiBandBitmap" default="2">
        <optionalConform>
          <feature name="WI"/>
        </optionalConform>
      </field>
    </command>
    <command id="0x07" name="ProxyMessageRequest" direction="commandToServer" response="ProxyMessageResponse">
      <quality largeMessage="true"/>
      <access invokePrivilege="operate" fabricScoped="true"/>
      <mandatoryConform/>
      <field id="0" name="SessionID" type="uint16">
        <mandatoryConform/>
      </field>
      <field id="1" name="ResponseTimeout" type="uint8">
        <mandatoryConform/>
      </field>
      <field id="2" name="Message" type="octstr">
        <quality nullable="true"/>
        <mandatoryConform/>
        <constraint>
          <maxLength value="1280"/>
        </constraint>
      </field>
    </command>
    <command id="0x08" name="ProxyMessageResponse" direction="responseFromServer">
      <quality largeMessage="true"/>
      <mandatoryConform/>
      <field id="0" name="SessionID" type="uint16">
        <mandatoryConform/>
      </field>
      <field id="1" name="Message" type="octstr">
        <quality nullable="true"/>
        <mandatoryConform/>
        <constraint>
          <maxLength value="1280"/>
        </constraint>
      </field>
    </command>
  </commands>
</cluster>
